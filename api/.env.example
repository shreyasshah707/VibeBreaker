# Backend Environment Variables

# Option 1: Free Open-Source via Groq (Recommended - 100% Free, zero payment or credit card needed)
DIGITALOCEAN_INFERENCE_API_KEY=your_groq_api_key_here
DIGITALOCEAN_INFERENCE_BASE_URL=https://api.groq.com/openai/v1
VIBEBREAKER_MODEL_NAME=qwen/qwen3.8-27b

# Option 2: DigitalOcean GenAI Inference
# DIGITALOCEAN_INFERENCE_API_KEY=your_digitalocean_key_here
# DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run
# VIBEBREAKER_MODEL_NAME=qwen-coder

DATABASE_URL=sqlite:///./vibebreaker.db